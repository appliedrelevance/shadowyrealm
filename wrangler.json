{
  "name": "shadowyrealm",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shadowyrealm.com", "custom_domain": true, "override_existing_origin": true, "override_existing_dns_record": true },
    { "pattern": "www.shadowyrealm.com", "custom_domain": true, "override_existing_origin": true, "override_existing_dns_record": true }
  ]
}
