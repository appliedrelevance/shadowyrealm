{
  "name": "shadowyrealm",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:tokens": "node tools/check-tokens.mjs",
    "dev": "SITE=shadowyrealm vite --host 0.0.0.0 --port 35420",
    "dev:inventions": "SITE=inventions vite --host 0.0.0.0 --port 35422",
    "build": "tsc && SITE=shadowyrealm vite build && SITE=inventions vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:inventions": "wrangler deploy --env inventions",
    "cf-typegen": "wrangler types",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "db:types": "bunx supabase gen types typescript --db-url postgresql://postgres:postgres@the-mark-of-gideon.local:35322/postgres --schema public,shadowyrealm,inventions > src/lib/database.types.ts",
    "test": "bun test ./test",
    "e2e": "playwright test",
    "content:load": "bun tools/realm-load.ts content/realm.ts",
    "content:load:inventions": "bun tools/realm-load.ts content/inventions/index.ts",
    "site-schema": "bun tools/site-schema.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "1.6.3",
    "@modelcontextprotocol/server": "^2.2.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.121.2",
    "@tanstack/router-vite-plugin": "^1.166.17",
    "agents": "^0.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.56.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@playwright/test": "^1.58.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "wrangler": "^4.22.0"
  },
  "packageManager": "bun@1.3.5"
}
